generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Equipamento {
  id          Int      @id @default(autoincrement())
  nome        String
  latitude    Float
  longitude   Float
  status      String

  tensao      Float?
  corrente    Float?
  temperatura Float?

  createdAt   DateTime @default(now())

  manutencoes Manutencao[]
  medicoes    Medicao[]
}

model Manutencao {
  id            Int         @id @default(autoincrement())
  tipo          String
  responsavel   String
  descricao     String
  status        String      @default("concluida")
  data          DateTime    @default(now())

  equipamentoId Int
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
}

model Medicao {
  id            Int      @id @default(autoincrement())
  temperatura   Float?
  tensao        Float?
  corrente      Float?
  data          DateTime @default(now())

  equipamentoId Int
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
}